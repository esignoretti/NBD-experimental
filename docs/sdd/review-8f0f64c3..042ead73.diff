@@ -1,19 +1,21 @@
 package nbd
 
 import (
 	"context"
 	"errors"
 	"fmt"
-	"io"
 	"net"
+	"sync/atomic"
 
+	"github.com/marmos91/dittofs/internal/adapter/common"
+	nbd "github.com/marmos91/dittofs/internal/adapter/nbd"
 	"github.com/marmos91/dittofs/pkg/adapter"
 	"github.com/marmos91/dittofs/pkg/controlplane/runtime"
