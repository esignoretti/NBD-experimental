+// DF, REQ_ONE and FAST_ZERO are each gated behind an advertisement the adapter
+// does not make, so none of them may appear on a READ.
+func TestConnection_UnadvertisedFlagIsEINVAL(t *testing.T) {
+	for _, flag := range []CommandFlags{FlagDF, FlagReqOne, FlagFastZero} {
+		t.Run(flagName(flag), func(t *testing.T) {
+			st := newStoreFake()
+			h := newTestHandler(st, testExport(8192), testTimeouts())
+			server, client := pipe(t)
+			serveConn(h, server)
+			completeHandshake(t, client, testExportName)
+
+			sendRequest(t, client, &Request{Type: CmdRead, Flags: flag, Cookie: 1, Offset: 0, Length: 4096})
+			rep := readReplyHeader(t, client)
+			if rep.Error != ErrEINVAL {
+				t.Fatalf("READ with %s reply error = %d, want ErrEINVAL (%d)", flagName(flag), rep.Error, uint32(ErrEINVAL))
+			}
+			assertNoPayload(t, client, 100*time.Millisecond)
+			if st.reads != 0 {
+				t.Fatalf("the store saw %d reads for a request with %s set", st.reads, flagName(flag))
+			}
+		})
+	}
+}
+
+// A command that arrives while the adapter is draining is answered with
+// NBD_ESHUTDOWN rather than served: it is the protocol's "reconnect" signal,
+// which is what the kernel's dead-connection timeout waits for. The connection
+// is deliberately NOT closed on the first draining observation — closing
+// immediately is what makes the client's kernel error the device instead of
+// pausing it, and the base adapter's drain deadline is the backstop.
+func TestConnection_DrainingAnswersESHUTDOWN(t *testing.T) {
+	st := newStoreFake()
+	st.data[testPayloadID] = make([]byte, 4096)
+
+	var draining atomic.Bool
+	h := NewHandler(exporterFor(testExport(8192)), resolverFor(st), nil,
+		Identity{UID: 65534, GID: 65534}, testTimeouts(), draining.Load)
+
+	server, client := pipe(t)
+	serveConn(h, server)
+	completeHandshake(t, client, testExportName)
+
+	draining.Store(true)
+
+	sendRequest(t, client, &Request{Type: CmdRead, Cookie: 9, Offset: 0, Length: 4096})
+	rep := readReplyHeader(t, client)
+	if rep.Error != ErrESHUTDOWN {
+		t.Fatalf("READ while draining reply error = %d, want ErrESHUTDOWN (%d)", rep.Error, uint32(ErrESHUTDOWN))
+	}
+	if rep.Cookie != 9 {
+		t.Fatalf("draining reply cookie = %d, want 9", rep.Cookie)
+	}
+	// The request must not have reached the store: it is answered, not served.
+	if st.reads != 0 {
+		t.Fatalf("the store saw %d reads for a command answered while draining", st.reads)
+	}
+	// The connection stays open, so a second command is still answerable.
+	sendRequest(t, client, &Request{Type: CmdRead, Cookie: 10, Offset: 0, Length: 4096})
+	if rep := readReplyHeader(t, client); rep.Error != ErrESHUTDOWN {
+		t.Fatalf("second draining READ reply error = %d, want ErrESHUTDOWN (%d)", rep.Error, uint32(ErrESHUTDOWN))
+	}
+}
+
+func flagName(f CommandFlags) string {
+	switch f {
+	case FlagFUA:
+		return "NBD_CMD_FLAG_FUA"
+	case FlagNoHole:
+		return "NBD_CMD_FLAG_NO_HOLE"
+	case FlagDF:
+		return "NBD_CMD_FLAG_DF"
+	case FlagReqOne:
+		return "NBD_CMD_FLAG_REQ_ONE"
+	case FlagFastZero:
+		return "NBD_CMD_FLAG_FAST_ZERO"
+	default:
+		return "flag"
+	}
+}
+
+// A client that sends a partial header and stalls must not hold the connection
+// open forever, and must not make the server allocate for a length it never
+// sent.
+func TestConnection_PartialHeaderTimesOut(t *testing.T) {
+	st := newStoreFake()
+	h := newTestHandler(st, testExport(8192),
+		Timeouts{Read: 200 * time.Millisecond, Write: 5 * time.Second, Idle: 5 * time.Second})
+	server, client := pipe(t)
+	done := serveConn(h, server)
+	completeHandshake(t, client, testExportName)
+
+	// Four bytes of the 28-byte header, then silence.
+	if _, err := client.Write([]byte{0x25, 0x60, 0x95, 0x13}); err != nil {
+		t.Fatalf("write partial header: %v", err)
+	}
+
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("serve returned nil after a partial header; a stalled client must end the connection")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("serve did not return within 2s of a 200ms read timeout")
+	}
+	assertNoPayload(t, client, 100*time.Millisecond)
+}
+
+func TestMapError_ClassifiesStoreAndContextErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		want NBDError
+	}{
+		{"nil", nil, 0},
+		{"store closed", engine.ErrStoreClosed, ErrEIO},
+		{"not durable yet", common.ErrNotDurableYet, ErrEIO},
+		{"no space", &merrs.StoreError{Code: merrs.ErrNoSpace, Message: "full"}, ErrENOSPC},
+		{"permission denied", &merrs.StoreError{Code: merrs.ErrPermissionDenied, Message: "nope"}, ErrEPERM},
+		// A RAW sentinel, not an already-wrapped StoreError: this case is what
+		// makes normalization load-bearing. ClassifyBlockStoreError maps
+		// journal.ErrLocalStoreFull to the no-space code, and the only thing
+		// that turns that raw error into a *merrs.StoreError is
+		// NormalizeBlockStoreError. Drop that call and this case collapses to
+		// ErrEIO, which is the disk-full-reports-as-I/O bug the mapping exists
+		// to prevent.
+		{"raw local store full", journal.ErrLocalStoreFull, ErrENOSPC},
+		{"wrapped raw local store full", fmt.Errorf("write: %w", journal.ErrLocalStoreFull), ErrENOSPC},
+		{"canceled", context.Canceled, ErrESHUTDOWN},
+		{"deadline exceeded", context.DeadlineExceeded, ErrESHUTDOWN},
+		{"opaque", errors.New("opaque engine fault"), ErrEIO},
+		{"wrapped store closed", fmt.Errorf("read: %w", engine.ErrStoreClosed), ErrEIO},
+		{"wrapped no space", fmt.Errorf("write: %w", &merrs.StoreError{Code: merrs.ErrNoSpace}), ErrENOSPC},
+		// A store failure wrapped in a cancellation must report the store
+		// failure: the operator needs to know the store is gone, not that a
+		// context expired.
+		{"store closed under a canceled context", fmt.Errorf("op: %w (%w)", engine.ErrStoreClosed, context.Canceled), ErrEIO},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := mapError(tt.err); got != tt.want {
+				t.Fatalf("mapError(%v) = %d, want %d", tt.err, got, uint32(tt.want))
+			}
+		})
+	}
+}
+
+// The auth context is built per command from the configured synthetic identity
+// and the export's read-only ceiling. It is never cached: it embeds the
+// command's context, so a cached one would carry the first command's deadline
+// and cancellation into every later command on the connection.
+func TestHandler_AuthContextCarriesIdentityAndReadOnlyCeiling(t *testing.T) {
+	h := NewHandler(exporterFor(testExport(8192)), resolverFor(newStoreFake()), nil,
+		Identity{UID: 1234, GID: 5678}, testTimeouts(), func() bool { return false })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	authCtx := h.authContext(ctx, &Export{ReadOnly: true})
+	if authCtx.Context != ctx {
+		t.Fatal("auth context does not carry the command's context")
+	}
+	if authCtx.Identity == nil || authCtx.Identity.UID == nil || authCtx.Identity.GID == nil {
+		t.Fatal("auth context has no identity")
+	}
+	if *authCtx.Identity.UID != 1234 || *authCtx.Identity.GID != 5678 {
+		t.Fatalf("auth context identity = %d/%d, want 1234/5678", *authCtx.Identity.UID, *authCtx.Identity.GID)
+	}
+	if !authCtx.ShareReadOnly {
+		t.Fatal("auth context does not apply the export's read-only ceiling")
+	}
+
+	// A second call must not share the first one's identity pointers.
+	other := h.authContext(context.Background(), &Export{})
+	if other.Identity.UID == authCtx.Identity.UID {
+		t.Fatal("two auth contexts share one identity pointer")
+	}
+	if other.ShareReadOnly {
+		t.Fatal("a writable export produced a read-only auth context")
+	}
+}
diff --git a/internal/adapter/nbd/handlers_read.go b/internal/adapter/nbd/handlers_read.go
new file mode 100644
index 00000000..4b0f924c
--- /dev/null
+++ b/internal/adapter/nbd/handlers_read.go
@@ -0,0 +1,88 @@
+package nbd
+
+import (
+	"context"
+	"math"
+	"net"
+
+	"github.com/marmos91/dittofs/internal/adapter/common"
+)
+
+// handleRead serves one NBD_CMD_READ.
+//
+// The checks run in this order — overflow, zero length, past the end, flags —
+// because a request that is both malformed and out of range must fail on the
+// malformation: the range check reads the request's own fields, so it cannot be
+// trusted until they have been shown to make sense.
+func (h *Handler) handleRead(ctx context.Context, bs BlockStore, exp *Export, req *Request, conn net.Conn) error {
+	// A client-supplied offset and length can overflow. The check is a
+	// subtraction rather than `req.Offset+uint64(req.Length) > exp.Size`,
+	// because that add wraps and lets a request that is far past the end look
+	// like it starts inside the export.
+	//
+	// decision: the answer is NBD_EIO, not NBD_EOVERFLOW. The spec reserves
+	// EOVERFLOW for READ with NBD_CMD_FLAG_DF and for a payload-less request
+	// over an advertised maximum, and the adapter advertises neither. The
+	// request is not out of range; it cannot be interpreted at all.
+	if uint64(req.Length) > math.MaxUint64-req.Offset {
+		if err := h.writeReply(conn, req.Cookie, ErrEIO, nil); err != nil {
+			return err
+		}
+		return nil
+	}
+
+	// The spec declines to specify a zero-length read beyond "SHOULD NOT
+	// disconnect". One uniform answer is chosen over a per-command table
+	// because no correct client sends one and the connection stays usable.
+	if req.Length == 0 {
+		if err := h.writeReply(conn, req.Cookie, ErrEINVAL, nil); err != nil {
+			return err
+		}
+		return nil
+	}
+
+	// The last byte of the device is addressable, so the range is out of bounds
+	// only when offset+length exceeds the size. A read that ends exactly at the
+	// end is served.
+	if req.Offset+uint64(req.Length) > exp.Size {
+		if err := h.writeReply(conn, req.Cookie, ErrEINVAL, nil); err != nil {
+			return err
+		}
+		return nil
+	}
+
+	// Flags are validated before the store is touched, so a malformed request
+	// never reaches it.
+	//
+	// FUA is accepted and ignored: the spec requires the server to accept it on
+	// every command once SEND_FUA is advertised ("the server MUST accept all
+	// commands with this bit set (even by ignoring the bit)") and notes that
+	// existing clients set it on commands other than WRITE. A read writes
+	// nothing, so there is nothing to persist. Every other flag is gated behind
+	// an advertisement the adapter does not make.
+	if req.Flags&^FlagFUA != 0 {
+		if err := h.writeReply(conn, req.Cookie, ErrEINVAL, nil); err != nil {
+			return err
+		}
+		return nil
+	}
+
+	// Allocated only after the bounds checks: a client that sends
+	// Length: 0xffffffff against a small export gets NBD_EINVAL without a
+	// multi-gigabyte allocation.
+	buf := make([]byte, req.Length)
+
+	// The deadline wrapper is applied per command, not per connection: a
+	// connection is long-lived, so a connection-wide budget would expire a boot
+	// disk mid-boot. It is a no-op when the context already carries a deadline.
+	readCtx, cancel := common.WithRequestDeadline(ctx)
+	defer cancel()
+
+	if _, err := bs.ReadAt(readCtx, string(exp.PayloadID), buf, req.Offset); err != nil {
+		// No payload on the error path: the reply shape for a failed READ is the
+		// header alone.
+		return h.writeReply(conn, req.Cookie, mapError(err), nil)
+	}
+
+	return h.writeReply(conn, req.Cookie, 0, buf)
+}
diff --git a/internal/adapter/nbd/integration_test.go b/internal/adapter/nbd/integration_test.go
new file mode 100644
index 00000000..92d68f34
--- /dev/null
+++ b/internal/adapter/nbd/integration_test.go
@@ -0,0 +1,214 @@
+package nbd
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/marmos91/dittofs/internal/adapter/common"
+	"github.com/marmos91/dittofs/internal/adapter/testruntime"
+	"github.com/marmos91/dittofs/pkg/block/engine"
+	"github.com/marmos91/dittofs/pkg/controlplane/models"
+	"github.com/marmos91/dittofs/pkg/controlplane/runtime"
+	"github.com/marmos91/dittofs/pkg/metadata"
+	"github.com/marmos91/dittofs/pkg/metadata/store/badger/badgertest"
+)
+
+// integrationShare is the share the fixture creates, and integrationVolume the
+// volume inside it, so the export name a client asks for is
+// integrationShare + "/" + integrationVolume.
+const (
+	integrationShare  = "/export"
+	integrationVolume = "boot"
+)
+
+// integrationExportName is the name the handler's exporter resolves.
+const integrationExportName = integrationShare + "/" + integrationVolume
+
+// newIntegrationFixture builds a runtime with one enabled share holding one
+// volume file, and returns the runtime, the export name, and the share's real
+// block store.
+//
+// The journal root comes from testruntime.New, so the local tier is an fs
+// store — which is what makes LocalDurable() true and the eviction assertions
+// below meaningful.
+func newIntegrationFixture(t *testing.T) (*runtime.Runtime, string, *engine.Store) {
+	t.Helper()
+	rt, bsID := testruntime.NewWithShareStore(t)
+	store := badgertest.NewInMemory(t)
+	if err := rt.RegisterMetadataStore("nbd-meta", store); err != nil {
+		t.Fatal(err)
+	}
+	// Enabled: true is load-bearing. AddShare copies the flag verbatim and
+	// nothing defaults it, so a share built without it is disabled — and the
+	// exporter refuses to resolve a disabled share, which would fail every test
+	// here with an ErrUnknownExport that names nothing about the real cause.
+	if err := rt.AddShare(context.Background(), &runtime.ShareConfig{
+		Name: integrationShare, MetadataStore: "nbd-meta", BlockStoreID: bsID,
+		Enabled:           true,
+		DefaultPermission: string(models.PermissionReadWrite),
+		RootAttr:          &metadata.FileAttr{UID: 1000, GID: 1000},
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	root, err := rt.GetRootHandle(integrationShare)
+	if err != nil {
+		t.Fatal(err)
+	}
+	metaSvc := rt.GetMetadataService()
+	authCtx := &metadata.AuthContext{
+		Context:  context.Background(),
+		Identity: &metadata.Identity{UID: ptr(uint32(1000)), GID: ptr(uint32(1000))},
+	}
+	vols, _, err := metaSvc.CreateDirectory(authCtx, root, "volumes", &metadata.FileAttr{Mode: 0o755})
+	if err != nil {
+		t.Fatal(err)
+	}
+	volsHandle, err := metadata.EncodeFileHandle(vols)
+	if err != nil {
+		t.Fatal(err)
+	}
+	created, _, err := metaSvc.CreateFile(authCtx, volsHandle, integrationVolume, &metadata.FileAttr{Mode: 0o644})
+	if err != nil {
+		t.Fatal(err)
+	}
+	createdHandle, err := metadata.EncodeFileHandle(created)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Creation zeroes the size, so the export size is set explicitly: it is
+	// fixed at creation and the handler bounds-checks against it.
+	if _, err := metaSvc.SetFileAttributes(authCtx, createdHandle, &metadata.SetAttrs{Size: ptr(uint64(1 << 20))}); err != nil {
+		t.Fatal(err)
+	}
+
+	bs, err := rt.GetBlockStoreForShare(integrationShare)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return rt, integrationExportName, bs
+}
+
+// integrationHandler builds the handler the way the adapter does: the real
+// runtime exporter, and a store resolver wrapping common.ResolveForWrite.
+func integrationHandler(rt *runtime.Runtime) *Handler {
+	id := Identity{UID: 65534, GID: 65534}
+	resolver := func(ctx context.Context, exp *Export) (BlockStore, error) {
+		return common.ResolveForWrite(ctx, rt, exp.Handle)
+	}
+	return NewHandler(NewRuntimeExporter(rt, id), resolver, rt.GetMetadataService(),
+		id, testTimeouts(), func() bool { return false })
+}
+
+// readThroughHandler drives one READ over the wire and returns the reply header
+// and payload.
+func readThroughHandler(t *testing.T, h *Handler, offset uint64, length uint32) (*Reply, []byte) {
+	t.Helper()
+	server, client := pipe(t)
+	serveConn(h, server)
+	completeHandshake(t, client, integrationExportName)
+	return readReplyAndPayload(t, client, &Request{
+		Type: CmdRead, Cookie: 42, Offset: offset, Length: length,
+	})
+}
+
+// TestIntegration_ReadAfterWriteOverRealStore is the end-to-end path over a
+// real engine.Store: bytes written into the volume come back byte-exact through
+// the handler's READ.
+func TestIntegration_ReadAfterWriteOverRealStore(t *testing.T) {
+	rt, _, bs := newIntegrationFixture(t)
+	h := integrationHandler(rt)
+
+	const size = 64 << 10
+	want := make([]byte, size)
+	for i := range want {
+		// Non-zero throughout, so a read that returns zeros fails rather than
+		// matching an unwritten range.
+		want[i] = byte(i%251) + 1
+	}
+	ctx := context.Background()
+	if _, err := bs.WriteAt(ctx, integrationPayloadID(t, rt), nil, want, 0); err != nil {
+		t.Fatalf("WriteAt: %v", err)
+	}
+
+	rep, got := readThroughHandler(t, h, 0, size)
+	if rep.Error != 0 {
+		t.Fatalf("READ reply error = %d, want 0", rep.Error)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatalf("READ returned %d bytes that do not match what was written", len(got))
+	}
+}
+
+// TestIntegration_ReadEvictedButManifestCoveredRange pins the hydrate path: a
+// range whose bytes have been evicted locally but are covered by the manifest
+// must read back real bytes, not zeros and not an error.
+func TestIntegration_ReadEvictedButManifestCoveredRange(t *testing.T) {
+	rt, _, bs := newIntegrationFixture(t)
+	h := integrationHandler(rt)
+
+	const size = 64 << 10
+	want := make([]byte, size)
+	for i := range want {
+		want[i] = byte(i%251) + 1
+	}
+	ctx := context.Background()
+	payloadID := integrationPayloadID(t, rt)
+	if _, err := bs.WriteAt(ctx, payloadID, nil, want, 0); err != nil {
+		t.Fatalf("WriteAt: %v", err)
+	}
+
+	// DrainAllUploads is what makes the bytes evictable: it force-flushes every
+	// dirty range to the remote and waits for the uploads to settle. Flush alone
+	// is not enough — with a durable local store and no strict enforcement it
+	// returns early without draining the remote, so the bytes stay dirty and
+	// journal.Evict skips any segment holding a dirty record.
+	if err := bs.DrainAllUploads(ctx); err != nil {
+		t.Fatalf("DrainAllUploads: %v", err)
+	}
+	ev, err := bs.DrainLocalSynced(ctx)
+	if err != nil {
+		t.Fatalf("DrainLocalSynced: %v", err)
+	}
+	// This assertion is the test's reason for existing: without it a fixture
+	// change that keeps the bytes local turns this into a test that passes while
+	// proving nothing.
+	if ev.SegmentsEvicted == 0 {
+		t.Fatalf("nothing was evicted, so this test cannot exercise the hydrate path: %+v", ev)
+	}
+
+	rep, got := readThroughHandler(t, h, 0, size)
+	if rep.Error != 0 {
+		t.Fatalf("READ of an evicted range returned error %d, want 0", rep.Error)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatal("READ of an evicted but manifest-covered range did not return the written bytes")
+	}
+}
+
+// TestIntegration_ReadNeverWrittenRangeIsZeros pins the engine's hole contract:
+// a range inside the export with no write ever reads as zeros, not as an error.
+func TestIntegration_ReadNeverWrittenRangeIsZeros(t *testing.T) {
+	rt, _, _ := newIntegrationFixture(t)
+	h := integrationHandler(rt)
+
+	rep, got := readThroughHandler(t, h, 0, 4096)
+	if rep.Error != 0 {
+		t.Fatalf("READ of an unwritten range returned error %d, want 0", rep.Error)
+	}
+	if !bytes.Equal(got, make([]byte, 4096)) {
+		t.Fatal("READ of an unwritten range did not return zeros")
+	}
+}
+
+// integrationPayloadID resolves the volume's payload ID the way the handler
+// does, through the exporter, so the test writes where the handler reads.
+func integrationPayloadID(t *testing.T, rt *runtime.Runtime) string {
+	t.Helper()
+	exp, err := NewRuntimeExporter(rt, Identity{UID: 65534, GID: 65534}).Resolve(context.Background(), integrationExportName)
+	if err != nil {
+		t.Fatalf("Resolve: %v", err)
+	}
+	return string(exp.PayloadID)
+}
diff --git a/internal/adapter/nbd/reply.go b/internal/adapter/nbd/reply.go
