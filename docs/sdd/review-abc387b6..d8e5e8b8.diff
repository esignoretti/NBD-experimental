 func serveWithRuntime(t *testing.T, cfg nbd.Config) (*nbd.Adapter, chan error) {
 	t.Helper()
 	rt, _ := testruntime.NewWithShareStore(t)
 	a := nbd.New(cfg)
 	a.SetRuntime(rt)
 	ctx, cancel := context.WithCancel(context.Background())
